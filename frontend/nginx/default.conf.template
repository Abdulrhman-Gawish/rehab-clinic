# nginx for the clinic UI. The image renders this file into /etc/nginx/conf.d/default.conf at container start;
# only ${BACKEND_URL} is substituted (NGINX_ENVSUBST_FILTER in the Dockerfile), every $name below is nginx's own.
#
# - Serves the Vite build as a single-page app: an unknown path falls back to index.html, so a reload on /book,
#   /blog/<id>, /reception, ... is handled by React Router.
# - Forwards /api/ to the backend on the SAME origin. The auth cookies are HttpOnly, Secure and SameSite=Strict on
#   path /api/v1: they only work when the browser reaches the API on the UI's own address.

map $uri $cache_control {
    # Vite's hashed bundles (assets/<name>-<8 character hash>.js|css): a new release gets new names.
    "~^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(?:js|css)$"  "public, max-age=31536000, immutable";
    # Brand images and photos copied from public/ keep their names: cache them for a day.
    "~^/assets/"                                     "public, max-age=86400";
    # The API sets its own headers (an empty value adds nothing).
    "~^/api/"                                        "";
    # index.html and the rest: revalidate every time, so a new release shows up at once.
    default                                          "no-cache";
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # The API caps uploads at 5 MB and answers larger ones with its own 413 (shown in the UI); leave it room to.
    client_max_body_size 10m;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml;

    add_header Cache-Control $cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    # Docker's embedded DNS. Because proxy_pass uses a variable, the backend's name is resolved per request (cached
    # 10 s): nginx starts even when the backend isn't running (the API answers 502 until it is) and follows a
    # recreated backend container to its new address.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend "${BACKEND_URL}";

    location /api/ {
        # No URI part: the request path (/api/v1/...) is passed unchanged.
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # The backend trusts one proxy hop (TRUST_PROXY=true): the last entry, added here, is the client address.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Container health check (the Dockerfile's HEALTHCHECK).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # A missing bundle is a 404, not index.html (which the browser would reject as a script or stylesheet).
    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
