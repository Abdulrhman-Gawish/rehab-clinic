# frontend/.env: copy this file to .env to change the Docker defaults (never commit .env). Optional: without it the
# defaults below apply.
#
# Who reads frontend/.env:
#   frontend service   frontend/docker-compose.yml, when the container is created (runtime, not the image build:
#                      the image build never sees any .env file)
#   Vite dev server    loads this file too, but only VITE_* variables reach the browser, so the two below never do
# The dev server's own settings (QUICK_LOGIN, SEED_OWNER_*, API_PROXY_TARGET) are read from backend/.env, not here.
#
# Leave VITE_API_URL unset: the UI must call /api/v1 on its own address (nginx or Vite forward it), because the login
# cookies only work on the same origin.

# Host port of the clinic UI (website, staff app and /api). Prefix an address to restrict it, e.g. 127.0.0.1:8080
# when only cloudflared or a reverse proxy on this machine should connect.
FRONTEND_PORT=8080
# Where nginx forwards /api: the backend service on the Docker network.
BACKEND_URL=http://backend:3000
