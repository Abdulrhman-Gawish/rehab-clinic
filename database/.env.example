# database/.env: copy this file to .env and adjust it (never commit .env).
#
# Who reads database/.env:
#   db service        database/docker-compose.yml: creates the database, user and password (as POSTGRES_DB,
#                     POSTGRES_USER, POSTGRES_PASSWORD) the first time, when the volume is empty
#   backend service   backend/docker-compose.yml loads this file after backend/.env, so the API connects with exactly
#                     these values (they win over the DB_* lines of backend/.env)
# The credentials are written once, here. Not used by the development database (backend/docker-compose.dev.yml).
#
# Applied only to an EMPTY volume. Changing them later does NOT change an existing database: run ALTER ROLE in psql
# first, then update this file (docs/DOCKER.md, section 7).
#
# Upgrading from the earlier single docker-compose.yml? Its database used clinic_db / clinic_user / clinic-docker
# (unless DOCKER_DB_PASSWORD was set): put those values here to keep using the existing data, then change the
# password as described above.

DB_DATABASE=clinic_db
DB_USERNAME=clinic_user
# Generate one (PowerShell): $b = New-Object byte[] 24; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })
DB_PASSWORD=change-me
