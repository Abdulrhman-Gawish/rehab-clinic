# Copy to .env and adjust. Validated at startup (src/config/env.validation.ts).

NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma separated origins allowed by CORS (e.g. the public website). Empty = CORS off.
CORS_ORIGINS=http://localhost:5173
# Set to true behind a reverse proxy so audit logs get the real client IP.
TRUST_PROXY=false
SWAGGER_ENABLED=true

# PostgreSQL (docker-compose.yml uses these too)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=clinic_user
DB_PASSWORD=change-me
DB_DATABASE=clinic_db
DB_LOGGING=false
# Database used by e2e tests (created and reset automatically). Defaults to <DB_DATABASE>_test.
DB_TEST_DATABASE=clinic_db_test

# Auth. Generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7

# Rate limiting (global default; login and public endpoints are stricter)
THROTTLE_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Scheduling / booking. The clinic zone observes DST: offsets are resolved per date.
CLINIC_TIMEZONE=Africa/Cairo
# Candidate slot starts every N minutes inside a doctor's schedule range
SLOT_INTERVAL_MINUTES=15
# Earliest bookable slot = now + this many minutes
BOOKING_MIN_LEAD_MINUTES=60
# Latest bookable local date = today + this many days
BOOKING_MAX_DAYS_AHEAD=30
# Max active future appointments one phone can hold via public booking
BOOKING_MAX_ACTIVE_PER_PHONE=3
# With allowOutsideSchedule, RECEPTIONIST may book up to N local days in the past; older is OWNER only
BACKDATE_MAX_DAYS=7

# Billing
# Highest effective discount (% of the subtotal) a RECEPTIONIST may give; OWNER has no limit
RECEPTIONIST_MAX_DISCOUNT_PERCENT=100

# First OWNER account, created by `npm run seed` (idempotent)
SEED_OWNER_NAME=Clinic Owner
SEED_OWNER_EMAIL=owner@clinic.local
SEED_OWNER_PASSWORD=change-me-please

# Optional pgAdmin (docker compose --profile tools up -d)
PGADMIN_EMAIL=admin@clinic.local
PGADMIN_PASSWORD=admin
