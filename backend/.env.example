# backend/.env: copy this file to .env and adjust it (never commit .env). Validated at startup
# (src/config/env.validation.ts): the API refuses to start on a missing or invalid value.
#
# Who reads backend/.env:
#   API without Docker   npm run start:dev, e2e tests, npm run migration:* / seed / storage:orphans
#   API in Docker        backend/docker-compose.yml: every variable below, EXCEPT these, fixed by the Docker setup:
#                        NODE_ENV=production, PORT=3000, DB_HOST=db, DB_PORT=5432, STORAGE_LOCAL_PATH=/app/storage,
#                        TRUST_PROXY=true; and DB_DATABASE / DB_USERNAME / DB_PASSWORD come from database/.env
#   Development DB       backend/docker-compose.dev.yml: DB_DATABASE, DB_USERNAME, DB_PASSWORD, DB_PORT, PGADMIN_*
#   Frontend dev server  frontend/vite.config.ts (npm run dev): QUICK_LOGIN, SEED_OWNER_EMAIL, SEED_OWNER_PASSWORD,
#                        API_PROXY_TARGET. The Docker frontend image never reads this file.
# Every variable, with who reads it: docs/DOCKER.md, section 6.

# ---- Server
# development | production | test (Docker always uses production)
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma separated origins allowed by CORS (e.g. the public website). Empty = CORS off.
# Not needed when the UI is served by the frontend container or Vite: they forward /api on the same origin.
CORS_ORIGINS=http://localhost:5173
# Set to true behind a reverse proxy so audit logs get the real client IP (Docker sets it to true).
TRUST_PROXY=false
# Consider false in production: Swagger lists every endpoint (it is also reachable through the frontend's /api/docs).
SWAGGER_ENABLED=true

# ---- Docker only (backend/docker-compose.yml)
# Host port of the API container, published on 127.0.0.1 only (browsers use the frontend's /api instead).
BACKEND_PORT=3000

# ---- PostgreSQL, for running WITHOUT Docker (npm run start:dev, e2e tests, docker-compose.dev.yml).
# The Docker backend ignores DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD / DB_DATABASE and uses database/.env.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=clinic_user
DB_PASSWORD=change-me
DB_DATABASE=clinic_db
# Log every SQL query
DB_LOGGING=false
# Database used by the e2e tests (created and wiped on every run; must differ from DB_DATABASE).
# Defaults to <DB_DATABASE>_test.
DB_TEST_DATABASE=clinic_db_test

# ---- Auth (token lifetimes are constants in src/modules/auth/auth.constants.ts: 15 min access, 7 day refresh)
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters

# ---- Rate limiting (the limits are constants in src/common/decorators/throttle.decorators.ts;
# counted per user when logged in, per email + IP on login, per IP on public routes)
THROTTLE_ENABLED=true

# ---- Scheduling / booking. The clinic zone observes DST: offsets are resolved per date.
CLINIC_TIMEZONE=Africa/Cairo
# Candidate slot starts every N minutes inside a doctor's schedule range
SLOT_INTERVAL_MINUTES=15
# Earliest bookable slot = now + this many minutes
BOOKING_MIN_LEAD_MINUTES=60
# Latest bookable local date = today + this many days
BOOKING_MAX_DAYS_AHEAD=30
# Max active future appointments one phone can hold via public booking
BOOKING_MAX_ACTIVE_PER_PHONE=3
# With allowOutsideSchedule, RECEPTIONIST may book up to N local days in the past; older is OWNER only
BACKDATE_MAX_DAYS=7

# ---- Billing
# Highest effective discount (% of the subtotal) a RECEPTIONIST may give; OWNER has no limit.
# 100 = no cap (the clinic's current choice); the owner can lower it here later.
RECEPTIONIST_MAX_DISCOUNT_PERCENT=100
# Invoices with a balance issued more than N days ago appear in GET /billing/attention
BILLING_OVERDUE_DAYS=7
# Printed on receipts
CLINIC_NAME=Rehab Clinic
CLINIC_PHONE=

# ---- File storage (expense receipts, patient attachments, blog covers) on local disk; never served statically
# (files are streamed by endpoints; only blog covers have a public one). Docker: /app/storage on the storage volume.
STORAGE_LOCAL_PATH=./storage

# ---- First OWNER account: created by `npm run seed` and by the Docker backend on start, only while the database has
# no OWNER (a fresh install). Once it exists the seed doesn't read these: you may remove the password after that.
SEED_OWNER_NAME=Clinic Owner
# A valid email with a real top-level domain (e.g. .com, .eg): a .local address is rejected and the seed fails.
SEED_OWNER_EMAIL=owner@example.com
# At least 8 characters
SEED_OWNER_PASSWORD=change-me-please

# ---- Frontend dev server only (frontend: npm run dev). Ignored by the API and by Docker.
# false hides the OWNER quick-login button and keeps SEED_OWNER_EMAIL/PASSWORD out of the UI bundle. Set it before
# sharing the dev server through a Cloudflare tunnel. The Docker frontend image is always built with false.
QUICK_LOGIN=true
# Where the dev server forwards /api (default http://localhost:3000). Uncomment to point it elsewhere.
# API_PROXY_TARGET=http://localhost:3000

# ---- pgAdmin for the development database (docker compose -f docker-compose.dev.yml --profile tools up -d),
# on http://localhost:5050. Use a normal email address: pgAdmin checks it at startup.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
